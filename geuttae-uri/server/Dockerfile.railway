FROM node:22-alpine
WORKDIR /app
COPY geuttae-uri /app/geuttae-uri
ENV HOST=0.0.0.0
ENV PORT=3000
EXPOSE 3000
# Railway supplies the dedicated /data volume. The launcher initializes its
# permissions, then drops to UID/GID 1000 before accepting network requests.
CMD ["node", "geuttae-uri/server/src/railway.mjs"]
